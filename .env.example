# Copy to .env and fill in values. Never commit .env.

# Neon PostgreSQL (pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT session secret (32+ characters)
AUTH_SECRET="replace-with-long-random-string"

# Public URLs
NEXT_PUBLIC_SITE_URL="https://venture-raven-dubgub.vercel.app"
NEXT_PUBLIC_LEARNING_APP_URL="https://learning-raven-dubgub.vercel.app"

# Optional: Sentry DSN for production error monitoring
# SENTRY_DSN=""

# Optional: separate Ludwitt/Hult app registration for venture metrics
# LUDWITT_APP_ID=""
# LUDWITT_API_KEY=""

# --- Social automation (Discord + Reddit): see docs/SOCIAL-AUTOMATION.md ---
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> copy URL
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Reddit: reddit.com/prefs/apps -> create "script" app -> client id + secret
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# REDDIT_USERNAME=""
# REDDIT_PASSWORD=""
# REDDIT_SUBREDDIT="codingbootcamp"
# REDDIT_REFRESH_TOKEN=""
