generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  STARTER
  PRO
}

enum ProductEventType {
  SIGNUP
  TEAM_CREATED
  LEARNER_INVITED
  DEMO_LESSON_STARTED
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  isInternal   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  teams        TeamWorkspace[]
  events       ProductEvent[]
}

model TeamWorkspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      PlanTier @default(STARTER)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductEvent {
  id        String           @id @default(cuid())
  type      ProductEventType
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata  String?
  createdAt DateTime         @default(now())

  @@index([userId, type])
  @@index([createdAt])
}

model InterviewSubmission {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  roleSegment        String
  organization       String?
  cohortSize         String?
  experienceLevel    String?
  onboardingProcess  String
  painPoints         String
  currentTools       String
  progressSignals    String
  idealOutcome       String
  pricingFeedback    String
  switchingCost      String
  productFeedback    String?
  followUpOk         Boolean  @default(false)
  introsOffered      String?
  willingnessToPilot String
  notableQuote       String?
  insight            String?
  contactName        String?
  contactEmail       String?
  consentGiven       Boolean

  @@index([createdAt])
  @@index([roleSegment])
}
